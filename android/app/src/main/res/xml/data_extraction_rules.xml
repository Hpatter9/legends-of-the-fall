<?xml version="1.0" encoding="utf-8"?>
<!-- STORE-READY (docs/notes/store-readiness.md): Android 12 and later. The save lives in the game page's own storage (the WebView's
     Local Storage, and IndexedDB for an Assault in progress); only that is backed up to the player's Google account and copied to a
     new phone, so a new phone or a reinstall keeps the save. Nothing else of the app's (its caches, the WebView's other files) goes. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Default/IndexedDB/" />
        <include domain="root" path="app_webview/Local Storage/" />
        <include domain="root" path="app_webview/IndexedDB/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Default/IndexedDB/" />
        <include domain="root" path="app_webview/Local Storage/" />
        <include domain="root" path="app_webview/IndexedDB/" />
    </device-transfer>
</data-extraction-rules>
